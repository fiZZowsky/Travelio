@page "/discover"
@inject IDestinationCatalog Catalog
@inject IRecommendationService Recommendations
@inject TravelDataClient Data
<PageTitle>@L.T("Odkrywaj · Travelio")</PageTitle>
<PageHeader Eyebrow="@L.T("DAJ SIĘ ZAINSPIROWAĆ")" Title="@L.T("Znajdź swoje miejsce na świecie.")" Subtitle="@L.T("Wyszukaj miasto i odkryj jego prawdziwe miejsca.")">
    <button class="button primary" @onclick="OpenQuiz"><Icon Name="sparkles" Size="18" />@L.T("Dobierz kierunek")</button>
</PageHeader>
<section class="panel"><CitySearch Selected="SelectCity" /></section>
@if (_error is not null) { <p class="notice error" role="alert">@_error</p> }
<div class="section-heading"><h2>@(_results is null ? L.T("Pomysły na następną podróż") : L.T("Kierunki dla Ciebie"))</h2>
@if (_results is not null) { <button class="text-link" @onclick="() => _results = null">@L.T("Wyczyść")</button> }</div>
<div class="destination-grid discovery-grid">
@foreach (var d in _results?.Select(x => x.Destination) ?? Catalog.All)
{
    var recommendation = _results?.FirstOrDefault(x => x.Destination.Id == d.Id);
    <div><DestinationCard Destination="@d" Tag="@(recommendation is null ? Display.Style(d.Styles.FirstOrDefault()) : recommendation.Match + L.T("% dopasowania"))" />
    @if (recommendation is not null) { <p class="match-reasons">@string.Join(" · ", recommendation.Reasons.Select(L.T))</p> }</div>
}
</div>
<p class="footnote">@L.T("Inspiracje dobieramy według zainteresowań i sezonu. Atrakcje pobieramy po wybraniu miasta. Zdjęcia mają charakter inspiracyjny.")</p>
@if (_quiz)
{
    <Modal Title="@L.T("Podróż zaczyna się od Ciebie")" Close="() => _quiz = false">
        <div class="quiz-progress">@for (var i = 0; i < 3; i++) { <span class="@(i <= _step ? "active" : "")"></span> }</div>
        <p class="eyebrow">@L.T("PYTANIE") @(_step + 1) @L.T("Z 3")</p>
        @if (_step == 0)
        {
            <h3>@L.T("Co sprawia Ci najwięcej radości?")</h3><div class="choice-grid">@foreach (var style in Enum.GetValues<TravelStyle>()) { <button class="choice @(_style == style ? "selected" : "")" @onclick="() => _style = style"><Icon Name="compass" />@Display.Style(style)</button> }</div>
        }
        else if (_step == 1)
        {
            <h3>@L.T("Jak wygląda Twoja wymarzona podróż?")</h3>
            <label>@L.T("Liczba dni")<input type="number" min="1" max="30" @bind="_days" /></label>
            <label>@L.T("Budżet dzienny na osobę (PLN, bez lotu)")<input type="range" min="150" max="1200" step="10" @bind="_budget" /><strong class="range-value">@Display.Money(_budget)</strong></label>
            <p class="footnote">@L.T("Budżet wykorzystamy jako Twój limit planu. Koszty rezerwacji sprawdzisz u dostawców.")</p>
            <label>@L.T("Tempo")<select @bind="_pace">@foreach (var pace in Enum.GetValues<TravelPace>()) { <option value="@pace">@Display.Pace(pace)</option> }</select></label>
        }
        else
        {
            <h3>@L.T("Kiedy i gdzie chcesz ruszyć?")</h3>
            <label>@L.T("Miesiąc wyjazdu")<select @bind="_month">@for (var m = 1; m <= 12; m++) { <option value="@m">@Display.Polish.DateTimeFormat.GetMonthName(m)</option> }</select></label>
            <label>@L.T("Region")<select @bind="_region"><option value="">@L.T("Niech świat mnie zaskoczy")</option><option value="Europa">@L.T("Europa")</option><option value="Azja">@L.T("Azja")</option></select></label>
        }
        @if (_quizError is not null) { <p class="notice error">@_quizError</p> }
        <div class="form-actions">@if (_step > 0) { <button class="button secondary" @onclick="() => _step--">@L.T("Wstecz")</button> }<button class="button primary" @onclick="Next">@(_step == 2 ? L.T("Pokaż moje kierunki") : L.T("Dalej"))<Icon Name="arrow" Size="18" /></button></div>
    </Modal>
}
@if (_selected is not null && !_newTrip)
{
    <Modal Title="@($"{L.T(_selected.Name)}, {L.T(_selected.Country)}")" Class="modal-wide" Close="() => _selected = null">
        <img class="modal-cover" src="@Display.Image(_selected)" alt="" /><p class="destination-description">@L.T(_selected.Description)</p>
        @if (_loading) { <p class="notice" role="status">@L.T("Pobieram miejsca z OpenStreetMap…")</p> }
        @if (_placeError is not null) { <div class="notice error">@_placeError <button class="text-link" @onclick="LoadPlaces">@L.T("Spróbuj ponownie")</button></div> }
        <div class="section-heading compact"><h3>@L.T("Miejsca warte odkrycia")</h3><span class="muted">@_selected.Attractions.Length @L.T("miejsc")</span></div>
        <div class="attraction-grid">@foreach (var place in _selected.Attractions.Take(18))
        { <div class="attraction-item"><span class="stat-icon mint"><Icon Name="pin" Size="18" /></span><div><strong>@Display.PlaceName(place)</strong><p>@L.T(place.Description)</p><a class="text-link" href="@TravelLinks.GoogleMaps(place.Name, place.Location)" target="_blank" rel="noopener noreferrer">@L.T("Mapy Google ↗")</a></div></div> }</div>
        @if (_selected.RetrievedAt is not null) { <p class="footnote">© OpenStreetMap contributors · @L.T("pobrano") @_selected.RetrievedAt.Value.ToLocalTime().ToString("g", Display.Polish). @L.T("Godziny i ceny sprawdź przed wizytą.")</p> }
        <button class="button primary full-width" @onclick="() => _newTrip = true"><Icon Name="plus" Size="18" />@L.T("Zaplanuj podróż") · @L.T(_selected.Name)</button>
    </Modal>
}
@if (_newTrip) { <NewTripForm DestinationId="@_selected?.Id" InitialDays="@(_results is null ? null : _days)" InitialPace="@(_results is null ? null : _pace)" InitialDailyBudget="@(_results is null ? null : _budget)" Close="() => _newTrip = false" /> }
@code {
    [SupplyParameterFromQuery(Name = "quiz")] public bool Quiz { get; set; }
    [SupplyParameterFromQuery(Name = "destination")] public string? DestinationId { get; set; }
    private bool _quiz, _newTrip, _loading, _quizOpened;
    private string? _loadedId, _error, _placeError, _quizError;
    private int _step, _days = 5, _month = DateTime.Today.Month;
    private decimal _budget = 400;
    private string _region = "";
    private TravelPace _pace = TravelPace.Balanced;
    private TravelStyle _style = TravelStyle.Culture;
    private Destination? _selected;
    private IReadOnlyList<DestinationRecommendation>? _results;
    protected override async Task OnParametersSetAsync()
    {
        if (Quiz && !_quizOpened) { _quizOpened = true; OpenQuiz(); }
        if (DestinationId is not null && DestinationId != _loadedId)
        {
            _loadedId = DestinationId;
            try { await SelectCity(await Data.GetCityAsync(DestinationId)); }
            catch (Exception ex) when (ex is DomainException or HttpRequestException) { _error = L.T(ex.Message); }
        }
    }
    private async Task SelectCity(Destination city) { _selected = city; await LoadPlaces(); }
    private async Task LoadPlaces()
    {
        if (_selected is null) return;
        var selectedId = _selected.Id;
        _loading = true; _placeError = null;
        try { var enriched = await Data.EnrichAsync(_selected); if (_selected?.Id == selectedId) _selected = enriched; }
        catch (Exception ex) when (ex is DomainException or JSException) { _placeError = ex.Message; }
        finally { _loading = false; }
    }
    private void OpenQuiz() { _quiz = true; _step = 0; _quizError = null; }
    private void Next()
    {
        _quizError = null;
        if (_days is < 1 or > 30) { _quizError = L.T("Wybierz od 1 do 30 dni."); return; }
        if (_step < 2) { _step++; return; }
        _results = Recommendations.Recommend(new(_budget, _days, _pace, _style, _month, _region));
        _quiz = false;
    }
}

