<div class="page-header"><div><div class="eyebrow">@Eyebrow</div><h1>@Title</h1><p>@Subtitle</p></div>@ChildContent</div>
@code {
    [Parameter] public string Eyebrow { get; set; } = "ZAPLANUJ COŚ DOBREGO";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

