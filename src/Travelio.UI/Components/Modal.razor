<div class="modal-backdrop" @onclick="Close">
    <section class="modal @Class" role="dialog" aria-modal="true" aria-label="@Title" tabindex="-1" @onclick:stopPropagation @onkeydown="KeyDown">
        <div class="modal-heading"><h2>@Title</h2><button class="icon-button" @onclick="Close" aria-label="Zamknij"><Icon Name="close" /></button></div>
        @ChildContent
    </section>
</div>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private Task KeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? Close.InvokeAsync() : Task.CompletedTask;
}

