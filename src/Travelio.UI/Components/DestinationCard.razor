<a href="@($"/discover?destination={Destination.Id}")" class="destination-card">
    <div class="destination-image"><img src="@Display.Image(Destination)" alt="@($"{L.T(Destination.Name)}, {L.T(Destination.Country)}")" loading="lazy" /><span class="destination-tag">@Tag</span><span class="destination-go"><Icon Name="arrow" Size="19" /></span></div>
    <div class="destination-info"><div><h3>@L.T(Destination.Name)</h3><span><Icon Name="pin" Size="13" />@L.T(Destination.Country)</span></div><div class="destination-price"><Icon Name="arrow" Size="20" /></div></div>
</a>
@code {
    [Parameter, EditorRequired] public Destination Destination { get; set; } = default!;
    [Parameter] public string Tag { get; set; } = L.T("Warto odkryć");
}

