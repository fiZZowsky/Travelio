@inject TravelDataClient Data
@inject IDestinationCatalog Catalog
@{ var destination = Catalog.Resolve(Trip); }
<div class="section-heading"><div><h2>Nocleg w dobrym miejscu</h2><p class="muted">Rzeczywiste obiekty w okolicy @destination.Name. Ceny, dostępność i opinie sprawdzisz na Booking.</p></div><a class="button primary" target="_blank" rel="noopener noreferrer" href="@TravelLinks.Booking(destination, Trip)">Szukaj na Booking ↗</a></div>
<p class="footnote">Rezerwacja: @Display.Date(Trip.StartDate) – @Display.Date(Trip.Days > 1 ? Trip.EndDate : Trip.StartDate.AddDays(1)) · @Trip.Travelers os. · @(Math.Max(1, Trip.Days - 1)) nocy. Dla jednodniowego wyjazdu wyszukujemy jedną noc; daty i pokoje możesz zmienić na Booking.</p>
@if (_busy) { <p class="notice" role="status">Pobieram noclegi z OpenStreetMap…</p> }
@if (_error is not null) { <p class="notice error">@_error <button class="text-link" @onclick="Load">Spróbuj ponownie</button></p> }
@if (_places is not null)
{
    <p class="footnote">@_places.Source · @(_places.IsStale ? "kopia offline z" : "pobrano") @_places.RetrievedAt.ToLocalTime().ToString("g", Display.Polish). Lista nie potwierdza dostępności na wybrane daty.</p>
    <div class="offers-grid">@foreach (var hotel in _places.Value.Accommodations.Take(_shown))
    { <section class="panel offer-card"><span class="stat-icon mint"><Icon Name="home" /></span><h3>@hotel.Name</h3><p>@(hotel.Address.Length == 0 ? destination.Name : hotel.Address)</p><div class="button-row"><a class="button primary small" target="_blank" rel="noopener noreferrer" href="@TravelLinks.Booking(destination, Trip, hotel.Name)">Sprawdź na Booking ↗</a><a class="text-link" target="_blank" rel="noopener noreferrer" href="@TravelLinks.GoogleMaps(hotel.Name, hotel.Location)">Mapa i opinie ↗</a></div></section> }</div>
    @if (_places.Value.Accommodations.Length > _shown) { <button class="button secondary" @onclick="() => _shown += 12">Pokaż więcej noclegów</button> }
    @if (_places.Value.Accommodations.Length == 0) { <p class="notice">Brak obiektów w bazie mapy dla tej okolicy. Wyszukiwarka Booking obejmuje również inne obiekty.</p> }
}
<div class="section-heading"><div><h2>Loty u przewoźnika</h2><p class="muted">Sprawdź połączenia i kup bilet na oficjalnej stronie linii.</p></div></div>
<div class="notice subtle"><Icon Name="plane" /><p>@destination.Name · @Trip.StartDate.ToString("dd.MM.yyyy") – @Trip.EndDate.ToString("dd.MM.yyyy") · @Trip.Travelers podróżników. Poniżej znajdziesz wyszukiwarki linii; przewoźnicy nie są potwierdzeni dla Twojej trasy. Cena i rozkład pojawią się po wyszukaniu u przewoźnika.</p></div>
<div class="airline-links">
@foreach (var airline in Airlines) { <a class="panel airline-link" href="@airline.Url" target="_blank" rel="noopener noreferrer"><Icon Name="plane" /><strong>@airline.Name</strong><span>Wyszukaj lot ↗</span></a> }
</div>
@code {
    [Parameter, EditorRequired] public Trip Trip { get; set; } = default!;
    private SourcedData<PlaceCollection>? _places;
    private string? _error, _loaded;
    private bool _busy;
    private int _shown = 12;
    private static readonly (string Name, string Url)[] Airlines = [("LOT", "https://www.lot.com/pl/pl"), ("Ryanair", "https://www.ryanair.com/pl/pl"), ("Wizz Air", "https://www.wizzair.com/"), ("Lufthansa", "https://www.lufthansa.com/pl/pl/homepage"), ("KLM", "https://www.klm.pl/"), ("Turkish Airlines", "https://www.turkishairlines.com/")];
    protected override async Task OnParametersSetAsync() { if (_loaded == Trip.DestinationId) return; _loaded = Trip.DestinationId; await Load(); }
    private async Task Load()
    {
        _busy = true; _error = null;
        try { _places = await Data.PlacesAsync(Catalog.Resolve(Trip)); }
        catch (Exception ex) when (ex is DomainException or JSException) { _error = ex.Message; }
        finally { _busy = false; }
    }
}

