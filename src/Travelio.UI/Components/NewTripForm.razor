@inject IDestinationCatalog Catalog
@inject TravelDataClient Data
@inject WorkspaceService Workspace
@inject NavigationManager Navigation

<Modal Title="Twoja następna przygoda" Close="Close">
    <p class="muted">Wybierz miasto. Pobierzemy miejsca do zwiedzania i ułożymy je w dni podróży.</p>
    <CitySearch Selected="SelectCity" />
    @if (_error is not null) { <div class="notice error" role="alert">@_error</div> }
    <form @onsubmit="Create" @onsubmit:preventDefault>
        <label>Nazwa podróży<input @bind="_name" required maxlength="100" placeholder="np. Włoskie dolce vita" autofocus /></label>
        <label>Kierunek<select value="@_destination" @onchange="ChangeDestination">@if (_selectedCity is not null && !_cities.Any(x => x.Id == _selectedCity.Id)) { <option value="@_selectedCity.Id">@_selectedCity.Name, @_selectedCity.Country</option> }@foreach (var d in _cities) { <option value="@d.Id">@d.Name, @d.Country</option> }</select><small>Zapisane kierunki są dostępne także bez serwera.</small></label>
        <div class="form-grid"><label>Data wyjazdu<input type="date" @bind="_date" required /></label><label>Liczba dni<input type="number" min="1" max="30" @bind="_days" required /></label></div>
        <div class="form-grid"><label>Podróżnicy<input type="number" min="1" max="20" @bind="_travelers" required /></label><label>Łączny budżet (PLN)<input type="number" min="0" max="100000000" step="0.01" @bind="_budget" required /></label></div>
        <label>Tempo podróży<select @bind="_pace">@foreach (var pace in Enum.GetValues<TravelPace>()) { <option value="@pace">@Display.Pace(pace)</option> }</select></label>
        <p class="footnote">Spokojnie: do 3 miejsc i dłuższe wizyty. W swoim rytmie: do 5. Intensywnie: do 7 i krótsze wizyty. Odległości i liczba dostępnych miejsc mogą ograniczyć plan.</p>
        <label class="checkbox-label"><input type="checkbox" @bind="_emptyPlan" /> Zacznij od pustego planu</label>
        <div class="form-actions"><button type="button" class="button secondary" @onclick="Close">Anuluj</button><button class="button primary" type="submit" disabled="@_busy"><Icon Name="sparkles" Size="18" />@(_busy ? "Pobieram miejsca i układam plan…" : "Stwórz podróż")</button></div>
    </form>
</Modal>
@code {
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public string? DestinationId { get; set; }
    [Parameter] public int? InitialDays { get; set; }
    [Parameter] public TravelPace? InitialPace { get; set; }
    [Parameter] public decimal? InitialDailyBudget { get; set; }
    private string _name = "", _destination = "lisbon";
    private DateOnly _date = DateOnly.FromDateTime(DateTime.Today).AddDays(14);
    private int _days = 5, _travelers = 2;
    private decimal _budget = 4800;
    private TravelPace _pace = TravelPace.Balanced;
    private string? _error;
    private bool _busy, _emptyPlan;
    private Destination? _selectedCity;
    private IReadOnlyList<Destination> _cities = [];
    protected override async Task OnInitializedAsync()
    {
        _days = InitialDays ?? _days; _pace = InitialPace ?? _pace;
        _cities = (await Data.RecentCitiesAsync()).Concat(Workspace.Trips.Select(x => Catalog.Resolve(x.Trip))).Concat(Catalog.All).DistinctBy(x => x.Id).ToArray();
        foreach (var city in _cities) Catalog.Register(city);
        if (InitialDailyBudget is { } daily) _budget = daily * _days * _travelers;
        try { SelectCity(await Data.GetCityAsync(DestinationId ?? "lisbon")); }
        catch (Exception ex) when (ex is DomainException or HttpRequestException) { _error = ex.Message; }
    }
    private void SelectCity(Destination city) { _selectedCity = city; _destination = city.Id; _name = $"Podróż · {city.Name}"; _error = null; }
    private async Task ChangeDestination(ChangeEventArgs e) => SelectCity(await Data.GetCityAsync(e.Value?.ToString() ?? "lisbon"));
    private async Task Create()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            var destination = _selectedCity ?? await Data.GetCityAsync(_destination);
            string? notice = null;
            if (!_emptyPlan) (destination, notice) = await Data.ForPlanningAsync(destination, Workspace.IsOnline || !Workspace.ConnectionChecked);
            Catalog.Register(destination);
            var trip = Workspace.CreateTrip(_name, _destination, _date, _days, _travelers, _budget, _pace);
            if (_emptyPlan) trip.Itinerary = Enumerable.Range(1, _days).Select(n => new PlanDay { Number = n }).ToList();
            await Workspace.SaveAsync(trip);
            Navigation.NavigateTo($"/trips/{trip.Id}" + (notice is null ? "" : "?notice=" + Uri.EscapeDataString(notice)));
            await Close.InvokeAsync();
        }
        catch (Exception ex) when (ex is DomainException or JSException or HttpRequestException or TaskCanceledException) { _error = ex is DomainException ? ex.Message : "Nie udało się zapisać podróży. Sprawdź połączenie i pamięć urządzenia."; }
        finally { _busy = false; }
    }
}

