@inject IDestinationCatalog Catalog
@inject TravelDataClient Data
@inject WorkspaceService Workspace
@inject NavigationManager Navigation

<Modal Title="@L.T("Twoja następna przygoda")" Close="Close">
    <p class="muted">@L.T("Wybierz miasto. Pobierzemy miejsca do zwiedzania i ułożymy je w dni podróży.")</p>
    <CitySearch Selected="SelectCity" />
    @if (_error is not null) { <div class="notice error" role="alert">@_error</div> }
    <form @onsubmit="Create" @onsubmit:preventDefault>
        <label>@L.T("Nazwa podróży")<input @bind="_name" required maxlength="100" placeholder="@L.T("np. Włoskie dolce vita")" autofocus /></label>
        <label>@L.T("Kierunek")<select value="@_destination" @onchange="ChangeDestination">@if (_selectedCity is not null && !_cities.Any(x => x.Id == _selectedCity.Id)) { <option value="@_selectedCity.Id">@L.T(_selectedCity.Name), @L.T(_selectedCity.Country)</option> }@foreach (var d in _cities) { <option value="@d.Id">@L.T(d.Name), @L.T(d.Country)</option> }</select><small>@L.T("Zapisane kierunki są dostępne także bez serwera.")</small></label>
        <div class="form-grid"><label>@L.T("Data wyjazdu")<input type="date" @bind="_date" required /></label><label>@L.T("Liczba dni")<input type="number" min="1" max="30" @bind="_days" required /></label></div>
        <div class="form-grid"><label>@L.T("Podróżnicy")<input type="number" min="1" max="20" @bind="_travelers" required /></label><label>@L.T("Łączny budżet (PLN)")<input type="number" min="0" max="100000000" step="0.01" @bind="_budget" required /></label></div>
        <label>@L.T("Tempo podróży")<select @bind="_pace">@foreach (var pace in Enum.GetValues<TravelPace>()) { <option value="@pace">@Display.Pace(pace)</option> }</select></label>
        <p class="footnote">@L.T("Tempo określa czas aktywności, przejść i przerw: spokojnie do 4,5 h, w swoim rytmie do 6,5 h, intensywnie do 9 h dziennie. Liczba miejsc wynika z długości wizyt. Czas potrzebny na zwiedzanie nie jest skracany.")</p>
        <label class="checkbox-label"><input type="checkbox" @bind="_emptyPlan" /> @L.T("Zacznij od pustego planu")</label>
        <div class="form-actions"><button type="button" class="button secondary" @onclick="Close">@L.T("Anuluj")</button><button class="button primary" type="submit" disabled="@_busy"><Icon Name="sparkles" Size="18" />@(_busy ? L.T("Pobieram miejsca i układam plan…") : L.T("Stwórz podróż"))</button></div>
    </form>
</Modal>
@code {
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public string? DestinationId { get; set; }
    [Parameter] public int? InitialDays { get; set; }
    [Parameter] public TravelPace? InitialPace { get; set; }
    [Parameter] public decimal? InitialDailyBudget { get; set; }
    private string _name = "", _destination = "lisbon";
    private DateOnly _date = DateOnly.FromDateTime(DateTime.Today).AddDays(14);
    private int _days = 5, _travelers = 2;
    private decimal _budget = 4800;
    private TravelPace _pace = TravelPace.Balanced;
    private string? _error;
    private bool _busy, _emptyPlan;
    private Destination? _selectedCity;
    private IReadOnlyList<Destination> _cities = [];
    protected override async Task OnInitializedAsync()
    {
        _days = InitialDays ?? _days; _pace = InitialPace ?? _pace;
        _cities = (await Data.RecentCitiesAsync()).Concat(Workspace.Trips.Select(x => Catalog.Resolve(x.Trip))).Concat(Catalog.All).DistinctBy(x => x.Id).ToArray();
        foreach (var city in _cities) Catalog.Register(city);
        if (InitialDailyBudget is { } daily) _budget = daily * _days * _travelers;
        try { SelectCity(await Data.GetCityAsync(DestinationId ?? "lisbon")); }
        catch (Exception ex) when (ex is DomainException or HttpRequestException) { _error = L.T(ex.Message); }
    }
    private void SelectCity(Destination city) { _selectedCity = city; _destination = city.Id; _name = L.F($"Podróż · {L.T(city.Name)}"); _error = null; }
    private async Task ChangeDestination(ChangeEventArgs e) => SelectCity(await Data.GetCityAsync(e.Value?.ToString() ?? "lisbon"));
    private async Task Create()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            var destination = _selectedCity ?? await Data.GetCityAsync(_destination);
            string? notice = null;
            if (!_emptyPlan) (destination, notice) = await Data.ForPlanningAsync(destination, Workspace.IsOnline || !Workspace.ConnectionChecked);
            Catalog.Register(destination);
            var trip = Workspace.CreateTrip(_name, _destination, _date, _days, _travelers, _budget, _pace);
            if (_emptyPlan) trip.Itinerary = Enumerable.Range(1, _days).Select(n => new PlanDay { Number = n }).ToList();
            await Workspace.SaveAsync(trip);
            Navigation.NavigateTo($"/trips/{trip.Id}" + (notice is null ? "" : "?notice=" + Uri.EscapeDataString(notice)));
            await Close.InvokeAsync();
        }
        catch (Exception ex) when (ex is DomainException or JSException or HttpRequestException or TaskCanceledException) { _error = ex is DomainException ? L.T(ex.Message) : L.T("Nie udało się zapisać podróży. Sprawdź połączenie i pamięć urządzenia."); }
        finally { _busy = false; }
    }
}

