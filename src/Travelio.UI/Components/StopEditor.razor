@inject TravelDataClient Data
@inject IDestinationCatalog Catalog
@inject WorkspaceService Workspace
<Modal Title="@(Stop is null ? L.T("Dodaj miejsce do planu") : L.T("Edytuj punkt planu"))" Class="modal-wide" Close="Close">
    <p class="muted">@L.T("Wpisz nazwę miejsca lub adres. Lokalizację znajdziemy za Ciebie.")</p>
    <div class="place-search"><label>@L.T("Nazwa miejsca lub adres")<input @bind="_query" @bind:event="oninput" maxlength="120" placeholder="@L.T("np. Wawel, kawiarnia, nazwa ulicy")" @onkeydown="KeyDown" /></label><button type="button" class="button secondary" disabled="@_searching" @onclick="Search"><Icon Name="search" Size="17" />@(_searching ? L.T("Szukam…") : L.T("Szukaj miejsca"))</button></div>
    @if (_error is not null) { <div class="notice error" role="alert">@_error</div> }
    @if (_places.Count > 0)
    {
        <p class="eyebrow">@(_searched ? L.T("WYNIKI W OKOLICY") : L.T("PROPOZYCJE Z POBRANEGO KATALOGU"))</p>
        <div class="place-results">
        @foreach (var place in _places.Take(16))
        { <button type="button" class="place-result @(_chosen?.Id == place.Id ? "selected" : "")" @onclick="() => Choose(place)"><Icon Name="pin" /><span><strong>@Display.PlaceName(place)</strong><small>@L.T(place.Description)</small></span><Icon Name="plus" Size="18" /></button> }
        </div>
    }
    else if (_searched && !_searching) { <p class="notice">@L.T("Nie znaleziono miejsca. Spróbuj pełniejszej nazwy lub adresu.")</p> }
    @if (_chosen is not null)
    {
        <div class="notice success"><Icon Name="pin" /><div><strong>@Display.PlaceName(_chosen)</strong><p>@L.T(_chosen.Description)</p><a href="@TravelLinks.GoogleMaps(_chosen.Name, _chosen.Location)" target="_blank" rel="noopener noreferrer" class="text-link">@L.T("Sprawdź w Mapach Google ↗")</a></div></div>
        @if (!string.IsNullOrWhiteSpace(_chosen.OpeningHours)) { <p class="footnote">@L.T("Godziny w OSM:") @_chosen.OpeningHours</p> }
        <form @onsubmit="Save" @onsubmit:preventDefault>
            <label>@L.T("Nazwa w Twoim planie")<input @bind="_title" required maxlength="200" /></label>
            <div class="form-grid"><label>@L.T("Dzień")<select @bind="_day">@for (var n = 1; n <= Trip.Days; n++) { <option value="@n">@L.F($"Dzień {n}") · @Display.Date(Trip.StartDate.AddDays(n - 1))</option> }</select></label><label>@L.T("Godzina wizyty")<input type="time" @bind="_time" required /></label></div>
            <div class="form-grid"><label>@L.T("Czas wizyty (min)")<input type="number" min="1" max="720" @bind="_duration" required /></label><label>@L.T("Szacowany koszt dla grupy (PLN)")<input type="number" min="0" max="1000000" step="0.01" @bind="_cost" placeholder="@L.T("Nieznany")" /></label></div>
            <div class="form-actions"><button type="button" class="button secondary" @onclick="Close">@L.T("Anuluj")</button><button class="button primary" type="submit" disabled="@_saving">@(Stop is null ? L.T("Dodaj do planu") : L.T("Zapisz punkt"))</button></div>
        </form>
    }
    <p class="footnote">@L.T("© OpenStreetMap contributors · Photon. Czasy wizyt są Twoim planem, a nie potwierdzeniem rezerwacji.")</p>
</Modal>
@code {
    [Parameter, EditorRequired] public Trip Trip { get; set; } = default!;
    [Parameter] public int Day { get; set; }
    [Parameter] public PlanStop? Stop { get; set; }
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public EventCallback Saved { get; set; }
    private string _query = "", _title = "";
    private string? _error;
    private bool _searching, _searched, _saving;
    private List<Attraction> _places = [];
    private Attraction? _chosen;
    private int _day, _duration = 60;
    private TimeOnly _time = new(15, 0);
    private decimal? _cost;
    protected override void OnInitialized()
    {
        _day = Day;
        var lastStop = Trip.Itinerary.FirstOrDefault(x => x.Number == Day)?.Stops.OrderBy(x => x.StartsAt).LastOrDefault();
        _time = lastStop is null ? new TimeOnly(9, 0) : lastStop.StartsAt.AddMinutes(lastStop.DurationMinutes + 20);
        var visitedIds = Trip.Itinerary.SelectMany(x => x.Stops).Select(x => x.AttractionId).ToHashSet();
        _places = Catalog.Resolve(Trip).Attractions.Where(x => !visitedIds.Contains(x.Id)).Take(16).ToList();
        if (Stop is not null)
        {
            _chosen = new(Stop.AttractionId, Stop.Title, L.T("Miejsce z Twojego planu"), TravelStyle.Culture,
                new(Stop.Latitude, Stop.Longitude), Stop.DurationMinutes, Stop.EstimatedCostPln, new(0, 0), new(23, 59), Stop.SourceUrl, Stop.OpeningHours,
                Stop.LocalizedNames, Stop.OriginalTitle, VisitDuration: Stop.VisitDuration);
            _title = Display.StopName(Stop); _time = Stop.StartsAt; _duration = Stop.DurationMinutes; _cost = Stop.EstimatedCostPln;
        }
    }
    private void Choose(Attraction place) { _chosen = place; _title = Display.PlaceName(place); _duration = place.DurationMinutes; _cost = place.CostPln * Trip.Travelers; _error = null; }
    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Enter" ? Search() : Task.CompletedTask;
    private async Task Search()
    {
        if (_searching) return;
        _searching = true; _searched = true; _error = null;
        var destination = Catalog.Resolve(Trip);
        _places = destination.Attractions.Where(x => x.Name.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase) ||
            x.LocalizedNames?.Values.Any(n => n.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase)) == true).ToList();
        try
        {
            if (_query.Trim().Length < 2) throw new DomainException("Wpisz przynajmniej 2 znaki nazwy lub adresu.");
            if (Workspace.IsOnline || !Workspace.ConnectionChecked)
            {
                var result = await Data.SearchPlacesAsync(_query, destination);
                _places = _places.Concat(result.Value).DistinctBy(x => x.Id).ToList();
            }
            else _error = L.T("Szukamy w zapisanych miejscach. Wyszukiwanie nowych adresów będzie dostępne po połączeniu z serwerem.");
        }
        catch (Exception ex) when (ex is DomainException or JSException) { _error = L.T(ex.Message); }
        finally { _searching = false; }
    }
    private async Task Save()
    {
        if (_chosen is null || _saving) return;
        _saving = true; _error = null;
        try
        {
            var trip = Workspace.Find(Trip.Id) ?? throw new DomainException(L.T("Nie znaleziono podróży."));
            var point = new PlanStop { Id = Stop?.Id ?? Guid.NewGuid(), AttractionId = _chosen.Id, Title = _title.Trim(),
                StartsAt = _time, DurationMinutes = _duration, EstimatedCostPln = _cost, Latitude = _chosen.Location.Latitude,
                Longitude = _chosen.Location.Longitude, SourceUrl = _chosen.SourceUrl, OpeningHours = _chosen.OpeningHours, Completed = Stop?.Completed ?? false,
                LocalizedNames = _chosen.LocalizedNames, OriginalTitle = _chosen.OriginalName,
                VisitDuration = _chosen.VisitDuration?.Minutes == _duration ? _chosen.VisitDuration : new(_duration, VisitDurationBasis.UserEstimate) };
            foreach (var day in trip.Itinerary) day.Stops.RemoveAll(x => x.Id == point.Id);
            var target = trip.Itinerary.FirstOrDefault(x => x.Number == _day);
            if (target is null) { target = new() { Number = _day }; trip.Itinerary.Add(target); }
            var end = _time.ToTimeSpan().TotalMinutes + _duration;
            if (end > 24 * 60 || target.Stops.Any(x => _time.ToTimeSpan().TotalMinutes < x.StartsAt.ToTimeSpan().TotalMinutes + x.DurationMinutes && end > x.StartsAt.ToTimeSpan().TotalMinutes))
                throw new DomainException(L.T("Wizyta nakłada się na inny punkt lub wykracza poza dzień. Wybierz inną godzinę."));
            target.Stops.Add(point); target.Stops = target.Stops.OrderBy(x => x.StartsAt).ToList();
            await Workspace.SaveAsync(trip);
            await Saved.InvokeAsync();
        }
        catch (Exception ex) when (ex is DomainException or JSException) { _error = L.T(ex.Message); }
        finally { _saving = false; }
    }
}
