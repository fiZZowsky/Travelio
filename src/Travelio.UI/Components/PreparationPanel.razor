@inject WorkspaceService Workspace
@inject IPreparationService Preparation
@inject IDestinationCatalog Catalog
@inject IRegionalAlertProvider Alerts

@{ var packed = Trip.PackingList.Count(x => x.Packed); }
<div class="preparation-grid">
    <section class="panel">
        <div class="section-heading compact"><h2>@L.T("Spakuj spokój")</h2><span class="pill mint">@packed / @Trip.PackingList.Count @L.T("gotowe")</span></div>
        <div class="mini-progress packing-progress"><span style="@($"width:{(packed * 100.0 / Math.Max(1, Trip.PackingList.Count)).ToString(CultureInfo.InvariantCulture)}%")"></span></div>
        @foreach (var group in Trip.PackingList.GroupBy(x => x.Category))
        {
            <h3 class="checklist-category">@L.T(group.Key)</h3>
            @foreach (var item in group) { <label class="checklist-item @(item.Packed ? "checked" : "")"><input type="checkbox" checked="@item.Packed" @onchange="() => Toggle(item.Id)" disabled="@(!CanEdit)" /><span>@L.T(item.Title)</span></label> }
        }
        @if (CanEdit) { <form class="inline-form" @onsubmit="AddItem" @onsubmit:preventDefault><input aria-label="@L.T("Nowy element listy")" placeholder="Co jeszcze zabierasz?" @bind="_newItem" maxlength="200" required /><button class="button secondary" type="submit" aria-label="@L.T("Dodaj do listy")"><Icon Name="plus" Size="18" /></button></form> }
        @if (_error is not null) { <p class="danger-text" role="alert">@_error</p> }
    </section>
    <div class="advice-stack">
        <section class="panel safety-card"><span class="stat-icon peach"><Icon Name="shield" /></span><h3>@L.T("Sprawdź, zanim wyruszysz")</h3>
            @if (_loading) { <p>@L.T("Sprawdzamy kanał komunikatów GDACS…")</p> }
            @foreach (var alert in _alerts)
            {
                <div class="regional-alert"><strong>@alert.Title</strong><p>@alert.Description</p>
                <span class="pill @(alert.IsVerified ? "mint" : "warning")">@(alert.IsVerified ? L.T("Dane ze źródła GDACS") : L.T("Brak potwierdzonych bieżących danych"))</span>
                @if (alert.CheckedAt is { } checkedAt) { <small>Ostatnie pobranie: @checkedAt.ToString("dd.MM.yyyy HH:mm 'UTC'")</small> }
                <a class="text-link" href="@alert.SourceUrl" target="_blank" rel="noopener noreferrer">@L.T("Otwórz źródło") <Icon Name="arrow" Size="17" /></a></div>
            }
        </section>
        @foreach (var advice in Preparation.GetAdvice(Catalog.Resolve(Trip))) { <section class="panel advice-card"><h3>@L.T(advice.Title)</h3><p>@L.T(advice.Description)</p>@if (advice.SourceUrl is not null) { <a href="@advice.SourceUrl" target="_blank" rel="noopener noreferrer" class="text-link">@L.T("Sprawdź u źródła") <Icon Name="arrow" Size="16" /></a> }</section> }
    </div>
</div>
@code {
    [Parameter, EditorRequired] public Trip Trip { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; } = true;
    [Parameter] public EventCallback Changed { get; set; }
    private IReadOnlyList<RegionalAlert> _alerts = [];
    private string _newItem = "";
    private string? _error;
    private string? _loadedDestination;
    private bool _loading;
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedDestination == Trip.DestinationId) return;
        _loadedDestination = Trip.DestinationId;
        _loading = true;
        _alerts = await Alerts.GetAlertsAsync(Catalog.Resolve(Trip));
        _loading = false;
    }
    private async Task Toggle(Guid id) => await Update(trip => { var item = trip.PackingList.Single(x => x.Id == id); item.Packed = !item.Packed; });
    private async Task AddItem()
    {
        if (string.IsNullOrWhiteSpace(_newItem)) return;
        await Update(trip => trip.PackingList.Add(new() { Title = _newItem.Trim(), Category = L.T("Moje rzeczy") }));
        if (_error is null) _newItem = "";
    }
    private async Task Update(Action<Trip> action)
    {
        _error = null;
        try { var current = Workspace.Find(Trip.Id)!; action(current); await Workspace.SaveAsync(current); await Changed.InvokeAsync(); }
        catch (DomainException ex) { _error = L.T(ex.Message); }
        catch (JSException) { _error = L.T("Nie udało się zapisać listy na urządzeniu."); }
    }
}

